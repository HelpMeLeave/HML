    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-nextjs": "^1.33.5",
    "@tanstack/react-store": "^0.11.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.51.0",
    "luxon": "^3.7.2",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
