{
  "name": "help-me-leave",
  "version": "1.5.0",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "private": true,
  "scripts": {
    "// ------------------------ UTIL SCRIPTS ------------------------ //": "",
    "payload": "NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/_config/payload.config.ts payload",
    "re": "pnpm payload generate:types && pnpm payload generate:importmap",
    "ck": "pnpm eslint . && pnpm tsc -noEmit",
    "knip": "SKIP_ENV_VALIDATION=1 knip",
    "// ------------------------ NEXT SCRIPTS ------------------------ //": "",
    "dev": "NODE_OPTIONS=--no-deprecation SKIP_ENV_VALIDATION=1 pnpm re && pnpm next dev",
    "build": "pnpm re && pnpm build:next",
    "build:next": "NODE_OPTIONS=--no-deprecation next build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "// ------------------------ CUSTOM SCRIPTS ------------------------ //": "",
    "update:payload": "node scripts/update-payload.mjs",
    "update:next": "node scripts/update-next.mjs",
    "update:react": "node scripts/update-react.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
