{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "noErrorTruncation": true,
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "@payloadcms/typescript-plugin"
      }
    ],
    "paths": {
      "@/*": ["./@types/*", "./src/*", "./public/*", "./.next/dev/types/*"],
      "www/*": ["./src/app/(www)/*"],
      "api/*": ["./src/app/(api)/*"]
    },
    "target": "ES2022",
    "typeRoots": ["./node_modules/@types", "./@types"],
    // "skipLibCheck": false
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "./**/*.ts",
    "./**/*.tsx",
    "./@types/**/*.ts",
    "./@types/**/*.d.ts",
    "./eslint.config.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/styles/tailwind.config.js"
  ],
  "exclude": ["./node_modules", "./src/migrations"]
}
