{
  "jsxSingleQuote": true,
  "singleQuote": true,
  "useTabs": false,
  "tabWidth": 2,
  "experimentalTernaries": true,
  "experimentalOperatorPosition": "start",
  "trailingComma": "es5",
  "bracketSameLine": true,
  "singleAttributePerLine": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "objectWrap": "preserve",
  "printWidth": 100,
  "semi": false,
  "quoteProps": "as-needed",
  "proseWrap": "never",
  "htmlWhitespaceSensitivity": "css",
  "plugins": [
    "prettier-plugin-organize-imports",
    "prettier-plugin-tailwindcss"
  ],
  "tailwindStylesheet": "./src/styles/www/index.css",
  "tailwindFunctions": [
    "cn",
    "cva"
  ],
  "overrides": [
    {
      "files": "*.css",
      "options": {
        "singleQuote": false,
        "objectWrap": "preserve"
      }
    },
    {
      "files": [
        "src/app/(www)/**/*"
      ],
      "options": {
        "tailwindStylesheet": "./src/styles/www/index.css"
      }
    },
    {
      "files": [
        "src/app/admin/**/*",
        "src/_components/**/*",
        "src/collections/**/*",
        "src/globals/**/*",
        "src/lexicals/**/*"
      ],
      "options": {
        "tailwindStylesheet": "./src/styles/admin/index.css"
      }
    }
  ]
}